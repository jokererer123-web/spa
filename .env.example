# ---------------------------------------------------------------------------
# Reina Spa — environment variables
# Copy to .env.local for development, and add the same keys in Netlify under
# Site settings → Environment variables.
#
# Both values are optional: without them the app runs on the built-in demo
# store, so every page and dashboard stays fully usable.
# ---------------------------------------------------------------------------

# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase → Project Settings → API → Project API keys → anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=
